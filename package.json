{
  "name": "finance-app",
  "version": "0.1.0",
  "private": true,
  "description": "Static finance calculators with commit-quality safeguards.",
  "scripts": {
    "format": "prettier --write \"**/*.{html,json,md,css,js}\"",
    "format:check": "prettier --check \"**/*.{html,json,md,css,js}\"",
    "lint": "htmlhint index.html",
    "typecheck": "node scripts/extract-inline-scripts.mjs && tsc --noEmit -p tsconfig.typecheck.json",
    "commit:prep": "npm run format:check && npm run lint && npm run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "htmlhint": "^1.7.1",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
